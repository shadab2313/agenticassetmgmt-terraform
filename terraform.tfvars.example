project     = "fleet-agent"
environment = "dev"
region      = "us-east-1"

# ---------------------------------------------------------------------------
# Existing network. All three are required; there are no sensible defaults.
#
# Find them with:
#
#   aws rds describe-db-instances \
#     --query 'DBInstances[*].{db:DBInstanceIdentifier,vpc:DBSubnetGroup.VpcId,sg:VpcSecurityGroups[0].VpcSecurityGroupId,endpoint:Endpoint.Address}' \
#     --output table
#
#   aws ec2 describe-subnets --filters Name=vpc-id,Values=vpc-XXXX \
#     --query 'Subnets[*].{id:SubnetId,az:AvailabilityZone,cidr:CidrBlock,public:MapPublicIpOnLaunch}' \
#     --output table
# ---------------------------------------------------------------------------

vpc_id = "vpc-XXXXXXXXXXXXXXXXX"

# Public subnets, at least two, in different AZs. AWS rejects a single-AZ ALB.
alb_subnet_ids = ["subnet-XXXXXXXXXXXXXXXXX", "subnet-YYYYYYYYYYYYYYYYY"]

# Private subnets for the instances. One entry keeps compute in a single AZ.
# These need outbound internet via NAT, or SSM VPC endpoints, or the SSM
# agent will not register and you will have no way to get a shell.
app_subnet_ids = ["subnet-ZZZZZZZZZZZZZZZZZ"]

# ---------------------------------------------------------------------------
# Existing database
# ---------------------------------------------------------------------------

existing_db_security_group_id = "sg-XXXXXXXXXXXXXXXXX"
existing_db_host              = "mydb.abc123.us-east-1.rds.amazonaws.com"
db_port                       = 5432

# Optional: if the password lives in Secrets Manager, the API instance role
# is granted read access to this ARN automatically.
existing_db_secret_arn = ""

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

ui_port  = 3000
api_port = 8080

# These paths must return 200 or the ALB marks every target unhealthy.
ui_health_check_path  = "/"
api_health_check_path = "/api/health"

# Leave both empty for an HTTP-only first deploy.
#
# DNS in Route 53: request/validate the cert there, then set certificate_arn.
# DNS elsewhere (e.g. Cloudflare): set domain_name and apply; this stack
# requests the cert and `terraform output acm_validation_record` gives you the
# CNAME to add at your DNS provider. Once `terraform output
# acm_certificate_status` shows ISSUED, copy the ARN from
# `terraform output acm_certificate_arn` into certificate_arn below and apply
# again — that second apply is what attaches it to the ALB.
domain_name     = ""
certificate_arn = ""

ui_instance_count  = 1
api_instance_count = 1

# ---------------------------------------------------------------------------
# NAT instance (optional)
#
# The pre-existing NAT Gateway costs a flat ~$66/month regardless of traffic.
# A small self-managed instance does the same job for ~$3.50/month, trading
# away AWS's managed multi-AZ failover. Off by default — this stack never
# touches your NAT Gateway or route tables unless you opt in.
#
# Rollout: enable + apply (creates the instance only, zero traffic impact) →
# verify it over SSM → flip use_nat_instance_for_egress + apply (cuts over
# the one route) → confirm the app and SSM still work → only then delete the
# old NAT Gateway by hand to actually realize the savings.
# ---------------------------------------------------------------------------

nat_instance_enabled        = false
use_nat_instance_for_egress = false
private_route_table_id      = ""
existing_nat_gateway_id     = ""
nat_instance_subnet_id      = ""
